# Auto detect text files and perform LF normalization
* text=auto

# Roblox place/model files must stay binary (rbx-merge)
*.rbxl  binary
*.rbxlx binary
*.rbxm  binary
*.rbxmx binary
# BEGIN rbx-merge (managed) — edit install flags and re-run, or delete to uninstall
# Safe default: a clone that has not run `rbx-merge install` treats these
# as binary, so Git refuses to line-merge them (conflict + keep ours)
# instead of silently corrupting structured Roblox files. `install`
# writes a higher-precedence override into .git/info/attributes.
*.rbxl binary
*.rbxlx binary
*.rbxm binary
*.rbxmx binary
# END rbx-merge
